{
  "name": "daily-escape",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.functions.json",
    "build:share": "npm run build && node scripts/build-artifact.mjs",
    "db:local": "wrangler d1 execute DB --local -c wrangler.local.toml --file=./migrations/0001_init.sql",
    "db:remote": "wrangler d1 execute DB --remote --file=./migrations/0001_init.sql",
    "dev:api": "npm run build && wrangler pages dev dist --d1=DB=DB --port 8788",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.115.0"
  }
}
