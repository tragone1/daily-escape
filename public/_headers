# Cloudflare Pages response headers.
#
# The bundle filename is content-hashed by Vite, so it can be cached hard and forever.
# index.html must not be, or a deploy would be invisible to anyone who has been here
# before - which is exactly the failure the build stamp exists to make debuggable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache
